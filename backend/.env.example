# Connexion MongoDB (Railway fournit MONGO_URL automatiquement via le plugin MongoDB)
MONGO_URL=

# Clé API Anthropic — utilisée pour l'étape 6 (support) uniquement (jamais exposée au frontend)
ANTHROPIC_API_KEY=

# Clé API DeepSeek — requise pour les étapes 1 à 5 (analyse, probleme, recherche, glossaire, plan)
# + pour le module News (filtrage strict des articles par thèmes admin + glossaire quotidien)
DEEPSEEK_API_KEY=

# Modèle DeepSeek utilisé (défaut : deepseek-v4-flash, mode non-thinking)
DEEPSEEK_MODEL=deepseek-v4-flash

# Budget maximal de tokens de sortie par génération DeepSeek (défaut : 8192)
DEEPSEEK_MAX_TOKENS=8192

# --- Module News : découverte via Serper.dev (OBLIGATOIRE pour la collecte) ---
# Créer un compte sur serper.dev puis renseigner la clé API (onglet "API Key").
# Serper expose les résultats Google Search en JSON (endpoint /search).
SERPER_API_KEY=

# Pays / langue des résultats Google renvoyés par Serper (défaut : fr)
# NEWS_GL=fr
# NEWS_HL=fr
# Âge maximum (jours) d'un article conservé, lorsque la page fournit sa date de
# publication (défaut : 7 — horizon "récent" de la veille). Sans date : non filtré.
NEWS_MAX_AGE_DAYS=7
# Nombre max de caractères de contenu stockés par article pour la lecture intégrée (défaut : 8000)
NEWS_CONTENT_MAX=8000
# Nombre max de caractères d'un article envoyés à DeepSeek pour le jugement (défaut : 1600)
NEWS_AI_TEXT_LIMIT=1600

# Modèle Anthropic utilisé (défaut : claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Budget maximal de tokens de sortie par génération Anthropic (défaut : 8192)
ANTHROPIC_MAX_TOKENS=8192

# Secret de signature des JWT (auth utilisateur + admin)
JWT_SECRET=

# Compte admin initial : e-mail de connexion + mot de passe (créé au démarrage si absent).
# Le mot de passe correspond à ADMIN_PASSWORD.
ADMIN_EMAIL=admin@grand-oral-studio.local
ADMIN_PASSWORD=

# Envoi des invitations par e-mail — Resend
# RESEND_FROM doit être un expéditeur vérifié dans Resend.
RESEND_API_KEY=
RESEND_FROM=Grand Oral Studio <onboarding@resend.dev>

# Port d'écoute (Railway la fournit automatiquement ; défaut local : 4000)
PORT=4000

# Origine(s) autorisées par CORS + base des liens d'invitation (domaine public du frontend)
FRONTEND_URL=http://localhost:5173

# --- Module News (veille IA / Big Data) ---
# Cron quotidien de collecte d'articles + glossaire du jour (désactivable).
# L'expression cron utilise le fuseau NEWS_CRON_TZ (défaut : Europe/Paris).
NEWS_CRON_ENABLED=true
NEWS_CRON_SCHEDULE=30 6 * * *
NEWS_CRON_TZ=Europe/Paris
# Plafonds de collecte par exécution (anti-surcharge réseau / tokens IA).
NEWS_MAX_PER_SOURCE=10
NEWS_MAX_PER_RUN=50
