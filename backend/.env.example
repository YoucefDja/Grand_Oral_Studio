# Connexion MongoDB (Railway fournit MONGO_URL automatiquement via le plugin MongoDB)
MONGO_URL=

# Clé API Anthropic — utilisée pour l'étape 6 (support) uniquement (jamais exposée au frontend)
ANTHROPIC_API_KEY=

# Clé API DeepSeek — requise pour les étapes 1 à 5 (analyse, probleme, recherche, glossaire, plan)
DEEPSEEK_API_KEY=

# Modèle DeepSeek utilisé (défaut : deepseek-v4-flash, mode non-thinking)
DEEPSEEK_MODEL=deepseek-v4-flash

# Budget maximal de tokens de sortie par génération DeepSeek (défaut : 8192)
DEEPSEEK_MAX_TOKENS=8192

# Modèle Anthropic utilisé (défaut : claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Budget maximal de tokens de sortie par génération Anthropic (défaut : 8192)
ANTHROPIC_MAX_TOKENS=8192

# Secret de signature des JWT (auth utilisateur + admin)
JWT_SECRET=

# Compte admin initial : e-mail de connexion + mot de passe (créé au démarrage si absent).
# Le mot de passe correspond à ADMIN_PASSWORD.
ADMIN_EMAIL=admin@grand-oral-studio.local
ADMIN_PASSWORD=

# Envoi des invitations par e-mail — Resend
# RESEND_FROM doit être un expéditeur vérifié dans Resend.
RESEND_API_KEY=
RESEND_FROM=Grand Oral Studio <onboarding@resend.dev>

# Port d'écoute (Railway la fournit automatiquement ; défaut local : 4000)
PORT=4000

# Origine(s) autorisées par CORS + base des liens d'invitation (domaine public du frontend)
FRONTEND_URL=http://localhost:5173
